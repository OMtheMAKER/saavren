# Copy this file to ".env" and fill in your keys. Never push keys to the repo.
#
# IMPORTANT — no quotes, no spaces around the value:
#     GROQ_API_KEY=gsk_abc123          <- correct
#     GROQ_API_KEY="gsk_abc123"        <- wrong (the quotes become part of the key)

HF_TOKEN=                      # huggingface.co -> Settings -> Access Tokens (Read)
                               # NOTE: since 2026-10-07 HF free accounts get NO
                               # Inference Providers credits -> chat/ASR via HF
                               # answers 402. Browser ASR then takes over.
BASETEN_API_KEY=               # baseten.co -> saavren workspace -> API Keys
GROQ_API_KEY=                  # console.groq.com -> API Keys (backup brain)

# optional overrides
# ENABLE_HF_LLM=1              # turn the HF router back on (needs credits)
# BASETEN_MODEL=meta-models/muse-spark-open   # Meta's newest open-weight model
# LLM_PROVIDER=groq            # force ONE provider: baseten | groq | hf | offline
# LLM_ORDER=groq,baseten       # or set the whole chain yourself
#                              # default = baseten, groq, then the offline mirror.
#                              # The HF router is only used when ENABLE_HF_LLM=1,
#                              # because free HF accounts have no provider credits.
# BASETEN_MODEL=meta-llama/Llama-4-Maverick-17B-128E-Instruct
#
# Groq retired llama-3.3-70b-versatile on 2026-08-16 — it now returns 404.
# Current ids, tried in order:
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.6-27b,openai/gpt-oss-20b
#
# Debugging: with the server running, open
#     http://localhost:8000/api/ai-status?probe=1
# it names the failing provider, the HTTP status and the models your key offers.

# ---- voice (speech -> text), tried in this order ---------------------------
# ASR_ORDER=mms,groq       # default; set ASR_ORDER=groq to skip Meta MMS
# ASR_MMS_PROVIDERS=fal,replicate,nebius,hf-inference   # HF router providers
# GROQ_ASR_MODEL=whisper-large-v3-turbo                 # free-tier safety net
